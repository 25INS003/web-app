# Web app — copy to .env and fill in.

NODE_ENV=development

# Browser-side API base. Keep it a SAME-ORIGIN path (nginx proxies /api to the
# backend) so the backend's httpOnly auth cookies stay first-party. Pointing
# this at a cross-origin host breaks cookie auth.
NEXT_PUBLIC_API_URL=/api/v1

# Server Components and getSession() reach the backend directly over the docker
# network, bypassing nginx.
API_INTERNAL_URL=http://ins03-backend-dev:8000/api/v1

# Playwright only — base URL the e2e suite drives.
E2E_BASE_URL=http://localhost
